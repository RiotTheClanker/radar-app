{
  "id": "map-layers",
  "name": "Map reference layers",
  "version": "1",
  "author": "Taa'a Yuku Radar",
  "description": "County and state lines, town names and roads drawn over the radar, so you can tell which county a storm is in without switching basemaps. Hillshade under it, for terrain. Each is its own switch in Layers.",
  "format": 1,
  "overlays": [
    {
      "id": "counties",
      "name": "County lines (US)",
      "type": "wms",
      "url": "https://tigerweb.geo.census.gov/arcgis/services/TIGERweb/tigerWMS_Current/MapServer/WMSServer",
      "layers": "11",
      "bounds": [
        17,
        -180,
        72,
        -64
      ],
      "minZoom": 5,
      "above": true,
      "opacity": 0.9,
      "attribution": "Boundaries: US Census Bureau TIGERweb"
    },
    {
      "id": "states",
      "name": "State lines (US)",
      "type": "wms",
      "url": "https://tigerweb.geo.census.gov/arcgis/services/TIGERweb/tigerWMS_Current/MapServer/WMSServer",
      "layers": "13",
      "bounds": [
        17,
        -180,
        72,
        -64
      ],
      "above": true,
      "attribution": "Boundaries: US Census Bureau TIGERweb"
    },
    {
      "id": "labels",
      "name": "Place names",
      "type": "tiles",
      "url": "https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Reference/MapServer/tile/{z}/{y}/{x}",
      "above": true,
      "attribution": "Labels © Esri, HERE, Garmin, © OpenStreetMap contributors"
    },
    {
      "id": "roads",
      "name": "Roads",
      "type": "tiles",
      "url": "https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Transportation/MapServer/tile/{z}/{y}/{x}",
      "minZoom": 6,
      "above": true,
      "opacity": 0.7,
      "visible": false,
      "attribution": "Roads © Esri, HERE, Garmin, © OpenStreetMap contributors"
    },
    {
      "id": "hillshade",
      "name": "Hillshade",
      "type": "tiles",
      "url": "https://server.arcgisonline.com/ArcGIS/rest/services/Elevation/World_Hillshade_Dark/MapServer/tile/{z}/{y}/{x}",
      "opacity": 0.35,
      "visible": false,
      "attribution": "Hillshade © Esri"
    }
  ]
}
